{
  "manifest_version": 3,
  "name": "Team Saved Replies",
  "description": "Share one set of comment templates with your team on GitHub. Keep them in a markdown file and everyone stays in sync.",
  "version": "0.1.0",
  "action": {
    "default_popup": "pages/popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{921737e1-c063-41c6-9adc-7b7e3e41fbfe}",
      "strict_min_version": "144.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "js/messaging.js",
      "js/message-receivers.js",
      "js/time.js",
      "js/null.js",
      "js/tabs.js",
      "js/urls.js",
      "js/team-sources.js",
      "js/events.js",
      "js/can-load-saved-replies.js",
      "js/fetch-saved-replies.js",
      "pages/background/background-storage.js",
      "pages/background/background-alarms.js",
      "pages/background/background-settings.js",
      "pages/background/background.js"
    ]
  },
  "sidebar_action": {
    "default_panel": "pages/sidepanel/saved-replies-sidepanel.html"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "css": [
        "pages/content-script/inline-template-menu.css"
      ],
      "js": [
        "js/time.js",
        "js/null.js",
        "js/create-element.js",
        "js/elements.js",
        "js/messaging.js",
        "js/message-receivers.js",
        "js/tabs.js",
        "js/urls.js",
        "js/team-sources.js",
        "js/sidepanel.js",
        "js/events.js",
        "js/can-load-saved-replies.js",
        "pages/content-script/content-script-copy-saved-reply-element.js",
        "pages/content-script/content-script-urls.js",
        "pages/content-script/content-script-messaging.js",
        "pages/content-script/inline-template-menu.js",
        "pages/content-script/content-script.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "pages/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "tabs",
    "webNavigation",
    "alarms",
    "storage",
    "menus"
  ],
  "host_permissions": [
    "https://github.com/*"
  ]
}
